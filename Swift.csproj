<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Swift</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationTitle>Swift</ApplicationTitle>
		<ApplicationId>com.kenan.swift</ApplicationId>
		<ApplicationIdGuid>0CCD2C00-CA33-4FB0-A564-DA426D6D2B83</ApplicationIdGuid>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<MauiXamlInflator>Runtime</MauiXamlInflator>
	
	</PropertyGroup>

	<ItemGroup>
		
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

	</ItemGroup>

	<ItemGroup>
	
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#000000" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#000000" BaseSize="180,180" />
		<MauiImage Include="Resources\Images\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	
	</ItemGroup>

</Project>
